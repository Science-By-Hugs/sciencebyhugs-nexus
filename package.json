{
  "name": "sciencebyhugs-nexus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode staging",
    "build": "tsc && vite build --mode staging",
    "preview": "vite preview",
    "test": "node --test tests/*.test.cjs",
    "verify:staging": "node scripts/verify-staging-build.mjs",
    "build:ios": "VITE_APP_ORIGIN=capacitor://localhost npm run build",
    "ios:sync": "npm run build:ios && cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/privacy-screen": "2.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capgo/capacitor-native-biometric": "8.8.3",
    "@supabase/supabase-js": "2.117.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0"
  }
}
