# Copy to .env.staging.local; replace the placeholders after Day 2 provisioning.
# Frontend: only the staging PUBLISHABLE key belongs here. Never put secrets in VITE_*.
VITE_APP_ENV=staging
VITE_SUPABASE_URL=https://REPLACE_WITH_STAGING_PROJECT_REF.supabase.co
VITE_EXPECTED_SUPABASE_REF=REPLACE_WITH_STAGING_PROJECT_REF
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
VITE_APP_ORIGIN=http://localhost:5173
VITE_PAYMENT_ENV=sandbox
VITE_ENABLE_TEST_PAYMENTS=false
